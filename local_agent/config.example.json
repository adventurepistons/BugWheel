{
  "aut_id": "demo-app",
  "base_url": "https://demowebshop.tricentis.com",
  "scan_flows": [
    {
      "name": "public",
      "login": null
    },
    {
      "name": "authenticated",
      "login": {
        "login_url": "https://demowebshop.tricentis.com/login",
        "username_selector": "#Email",
        "password_selector": "#Password",
        "login_button_selector": "#loginBtn",
        "username": "user@example.com",
        "password": "supersecret"
      }
    }
  ],
  "scan": {
    "max_pages": 10,
    "concurrency": 2,
    "include_patterns": ["/dashboard", "/profile"],
    "exclude_patterns": ["/logout", "/admin"]
  },
  "backend": {
    "progress_url": "https://your-backend.com/api/scan_progress",
    "result_url": "https://your-backend.com/api/scan_result",
    "api_key": "your-api-key"
  }
} 